<mxfile host="app.diagrams.net" type="device"><diagram id="amao1" name="Exercício à mão — Notificações"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Exercício dos 4 pilares — para fazer À MÃO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Domínio: &lt;b&gt;Notificações da Melodia&lt;/b&gt;. Leia o cenário, observe o “estado atual” (com o problema) e &lt;b&gt;redesenhe o diagrama de classes no papel&lt;/b&gt;, aplicando os quatro pilares. Não é para programar — é para &lt;b&gt;modelar e justificar&lt;/b&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="900" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;📋 O que entregar (no papel)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1) Abstração + Herança.&lt;/b&gt; As três classes ao lado repetem os mesmos dados e a mesma operação. Crie a superclasse abstrata &lt;b&gt;Notificacao&lt;/b&gt; (nome em itálico, «abstract») com o que é &lt;b&gt;essencial a toda notificação&lt;/b&gt; (destinatario, mensagem, enviada) e a operação abstrata &lt;i&gt;enviar()&lt;/i&gt;. Ligue as três com o &lt;b&gt;triângulo vazio ──▷&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;2) Encapsulamento.&lt;/b&gt; Marque &lt;b&gt;enviada&lt;/b&gt; como privado (&lt;b&gt;-&lt;/b&gt;). Escreva, numa nota, o &lt;b&gt;invariante&lt;/b&gt;: “uma notificação não pode ser enviada duas vezes” — e diga qual operação o protege.&lt;br&gt;&lt;br&gt;&lt;b&gt;3) Polimorfismo.&lt;/b&gt; Mostre &lt;i&gt;enviar()&lt;/i&gt; &lt;b&gt;redefinida&lt;/b&gt; em cada tipo. Depois acrescente um &lt;b&gt;tipo NOVO&lt;/b&gt;, &lt;b&gt;NotificacaoInApp&lt;/b&gt;, &lt;b&gt;sem alterar&lt;/b&gt; as outras classes (princípio Aberto/Fechado).&lt;br&gt;&lt;br&gt;&lt;b&gt;4) Associação + multiplicidade.&lt;/b&gt; Um &lt;b&gt;Ouvinte&lt;/b&gt; recebe &lt;b&gt;muitas&lt;/b&gt; notificações. Desenhe essa ligação com a &lt;b&gt;multiplicidade&lt;/b&gt; nos dois lados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#1F3A5F;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;arcSize=6;spacingLeft=10;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="470" height="480" as="geometry"/></mxCell><mxCell id="c5" value="⚠️ Estado atual (repare na DUPLICAÇÃO):" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="400" height="24" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;NotificacaoPush&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- destinatario : String&lt;br/&gt;- mensagem : String&lt;br/&gt;- enviada : boolean&lt;hr size=&quot;1&quot;/&gt;+ enviar() : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="540" y="156" width="200" height="104" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;NotificacaoEmail&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- destinatario : String&lt;br/&gt;- mensagem : String&lt;br/&gt;- enviada : boolean&lt;br/&gt;- assunto : String&lt;hr size=&quot;1&quot;/&gt;+ enviar() : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="540" y="330" width="200" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;NotificacaoSMS&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- destinatario : String&lt;br/&gt;- mensagem : String&lt;br/&gt;- enviada : boolean&lt;br/&gt;- numeroTelefone : String&lt;hr size=&quot;1&quot;/&gt;+ enviar() : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="760" y="156" width="200" height="120" as="geometry"/></mxCell><mxCell id="c9" value="Os mesmos 3 atributos e o mesmo enviar() aparecem em toda classe. Se a regra de “enviada” mudar, você conserta em 3 lugares. É essa dor que os pilares eliminam." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;size=16;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="770" y="340" width="190" height="160" as="geometry"/></mxCell><mxCell id="c10" value="✍  Desenhe aqui a sua solução (ou no verso da folha)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#9AA3AD;align=center;verticalAlign=middle;fontSize=13;fontColor=#5B6570;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="540" y="512" width="420" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Notação (lembrete)&lt;/b&gt;&lt;br&gt;• Classe abstrata: nome em &lt;i&gt;itálico&lt;/i&gt; + «abstract»&lt;br&gt;• Herança/generalização: linha com &lt;b&gt;triângulo vazio&lt;/b&gt; ──▷ para a superclasse&lt;br&gt;• Visibilidade: &lt;b&gt;-&lt;/b&gt; privado &amp;nbsp; &lt;b&gt;+&lt;/b&gt; público &amp;nbsp; &lt;b&gt;#&lt;/b&gt; protegido&lt;br&gt;• Associação: linha com &lt;b&gt;multiplicidade&lt;/b&gt; (1, 0..1, *, 1..*)&lt;br&gt;• Polimorfismo: a MESMA operação abstrata &lt;b&gt;redefinida&lt;/b&gt; em cada subclasse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFD;strokeColor=#C7CDD4;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;arcSize=6;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="470" height="140" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;✅ Critério de “pronto”&lt;/b&gt;&lt;br&gt;Nenhum atributo comum aparece repetido; a superclasse concentra o essencial; acrescentar &lt;b&gt;NotificacaoInApp&lt;/b&gt; não obrigou a mexer nas outras; e a associação Ouvinte–Notificacao tem multiplicidade nos dois lados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFD;strokeColor=#C7CDD4;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;arcSize=6;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="540" y="720" width="420" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>