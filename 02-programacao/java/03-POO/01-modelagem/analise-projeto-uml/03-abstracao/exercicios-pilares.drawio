                <mxCell id="nota-20" value="&lt;b&gt;B&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
