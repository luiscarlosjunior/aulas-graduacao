<mxfile host="65bd71144e">
    <diagram id="nota" name="0 · Como usar + notação">
        <mxGraphModel dx="1068" dy="631" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="nota-1" value="Exercícios dos 4 pilares — resolva AQUI no draw.io" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1F3A5F;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1000" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="nota-2" value="Em cada aba há: 🟨 mais informações · 📋 o enunciado · 🔷 classes de partida · ✍️ uma área tracejada para você desenhar a resposta. Copie os estilos de seta desta página." style="text;html=1;fontSize=13;fontColor=#5B6570;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="66" width="1300" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="nota-3" value="Como desenhar no draw.io:&lt;br&gt;&lt;br&gt;• &lt;b&gt;Classe&lt;/b&gt;: use o formato com 3 divisões (nome / atributos / operações). Duplo-clique para editar.&lt;br&gt;• &lt;b&gt;Herança&lt;/b&gt; (triângulo vazio): arraste uma seta e, no painel &lt;i&gt;Style&lt;/i&gt;, use a ponta de triângulo vazio.&lt;br&gt;• &lt;b&gt;Agregação&lt;/b&gt; (losango vazio) e &lt;b&gt;Composição&lt;/b&gt; (losango cheio): ponta de losango na extremidade do TODO.&lt;br&gt;• &lt;b&gt;Visibilidade&lt;/b&gt;: escreva - (privado), + (público), # (protegido) antes de cada membro.&lt;br&gt;&lt;br&gt;Dica: clique numa das setas de exemplo ao lado, copie (Ctrl+C / Ctrl+V) e religue nas suas classes." style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="140" width="470" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="nota-4" value="&lt;b&gt;NomeDaClasse&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- atributoPrivado : Tipo&lt;br/&gt;+ atributoPublico : Tipo&lt;hr size=&quot;1&quot;/&gt;+ operacao() : Tipo" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="560" y="150" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="nota-5" value="&amp;laquo;abstract&amp;raquo;&lt;br/&gt;&lt;i&gt;&lt;b&gt;ClasseAbstrata&lt;/b&gt;&lt;/i&gt;&lt;hr size=&quot;1&quot;/&gt;# atributoProtegido : Tipo&lt;hr size=&quot;1&quot;/&gt;+ operacaoAbstrata()* : Tipo" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#EDE7F6;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="880" y="150" width="260" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="nota-6" value="Exemplos de relacionamento (copie o estilo da seta):" style="text;html=1;fontSize=13;fontColor=#5B6570;align=left;" parent="1" vertex="1">
                    <mxGeometry x="560" y="320" width="700" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="nota-7" value="&lt;b&gt;SuperClasse&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="560" y="360" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="nota-8" value="&lt;b&gt;SubClasse&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="560" y="470" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="nota-9" value="" style="endArrow=block;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="nota-8" target="nota-7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="nota-10" value="Herança / generalização — triângulo VAZIO ──▷ (aponta p/ a super)" style="text;html=1;fontSize=13;fontColor=#5B6570;align=left;" parent="1" vertex="1">
                    <mxGeometry x="760" y="400" width="380" height="40" as="geometry"/>
