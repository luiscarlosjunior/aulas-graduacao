                <mxCell id="nota-18" value="Composição — losango CHEIO ◆ (parte morre com o todo)" style="text;html=1;fontSize=13;fontColor=#5B6570;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="655" width="340" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="nota-19" value="&lt;b&gt;A&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
