                <mxCell id="nota-17" value="" style="startArrow=diamondThin;startFill=1;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="nota-15" target="nota-16" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
