                <mxCell id="nota-12" value="&lt;b&gt;Parte&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="820" y="570" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="nota-13" value="" style="startArrow=diamondThin;startFill=0;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" parent="1" source="nota-11" target="nota-12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
