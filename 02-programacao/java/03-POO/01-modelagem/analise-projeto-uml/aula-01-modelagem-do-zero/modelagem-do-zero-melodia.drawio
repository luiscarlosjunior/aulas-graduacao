<mxfile host="app.diagrams.net" agent="aulas-graduacao" type="device"><diagram id="capa" name="0 · Capa"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="capa-0"/><mxCell id="capa-1" parent="capa-0"/><mxCell id="capa-1" value="Aula 01 — Modelagem do zero: de uma frase a um sistema (tipo Spotify)" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="capa-2" value="Como um requisito simples do cliente vira um modelo concreto — um estágio por vez" style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="capa-3" value="&lt;b&gt;🎧 O pedido do cliente (uma frase!):&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;&quot;Quero um aplicativo onde as pessoas possam &lt;b&gt;ouvir músicas&lt;/b&gt; quando quiserem, montar suas próprias &lt;b&gt;listas&lt;/b&gt; e seguir seus &lt;b&gt;artistas&lt;/b&gt; favoritos. Quem quiser, &lt;b&gt;paga uma assinatura&lt;/b&gt; para ouvir sem anúncios.&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;É só isto que temos. Nas próximas páginas, saímos desta frase e chegamos a um &lt;b&gt;diagrama de classes concreto&lt;/b&gt; — mostrando &lt;u&gt;por que modelar importa&lt;/u&gt;." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="620" height="300" as="geometry"/></mxCell><mxCell id="capa-4" value="&lt;b&gt;Por que modelar antes de programar?&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 🧠 &lt;b&gt;Pensar&lt;/b&gt; o problema antes de codar (erro no papel é barato).&lt;br&gt;• 🗣️ &lt;b&gt;Comunicar&lt;/b&gt; a mesma ideia para cliente e equipe.&lt;br&gt;• 🧩 &lt;b&gt;Descobrir&lt;/b&gt; entidades, relações e regras escondidas.&lt;br&gt;• 🏗️ &lt;b&gt;Guiar&lt;/b&gt; o código: o modelo vira as classes Java.&lt;br&gt;&lt;br&gt;&lt;b&gt;Como navegar este arquivo:&lt;/b&gt; cada aba embaixo é um &lt;b&gt;estágio&lt;/b&gt; da evolução (v1 → v7). Verde = o que &lt;b&gt;nasceu&lt;/b&gt; naquele estágio." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fillColor=#F5F5F5;strokeColor=#666666;rounded=1;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="620" height="300" as="geometry"/></mxCell><mxCell id="capa-5" value="👉 Dica de condução: peça aos alunos que &lt;b&gt;grifem os substantivos e verbos&lt;/b&gt; da frase acima antes de virar a página. Substantivo tende a virar &lt;b&gt;classe/atributo&lt;/b&gt;; verbo, &lt;b&gt;operação&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fillColor=#FFE6CC;strokeColor=#D79B00;rounded=1;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="1300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="texto" name="1 · Do texto ao modelo"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="texto-0"/><mxCell id="texto-1" parent="texto-0"/><mxCell id="texto-1" value="Estágio 1 — Do texto ao modelo: grifar substantivos e verbos" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="texto-2" value="&lt;b&gt;Requisito:&lt;/b&gt; &quot;As &lt;b&gt;pessoas&lt;/b&gt; &lt;i&gt;ouvem&lt;/i&gt; &lt;b&gt;músicas&lt;/b&gt;, montam &lt;b&gt;listas&lt;/b&gt; e seguem &lt;b&gt;artistas&lt;/b&gt;. Quem quiser &lt;i&gt;paga&lt;/i&gt; uma &lt;b&gt;assinatura&lt;/b&gt;.&quot;" style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="560" height="150" as="geometry"/></mxCell><mxCell id="texto-3" value="Substantivo → &lt;b&gt;Classe / Atributo&lt;/b&gt;&lt;br&gt;pessoa, música, lista, artista, assinatura" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=14;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="560" height="70" as="geometry"/></mxCell><mxCell id="texto-4" value="Verbo → &lt;b&gt;Operação&lt;/b&gt;&lt;br&gt;ouvir, montar, seguir, pagar" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="560" height="70" as="geometry"/></mxCell><mxCell id="texto-5" value="" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="texto-2" target="texto-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="texto-6" value="" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="texto-2" target="texto-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="texto-7" value="&lt;b&gt;💬 Para explicar em aula:&lt;/b&gt;&lt;br&gt;&lt;br&gt;A própria gramática do pedido entrega o modelo:&lt;br&gt;• &lt;b&gt;Substantivos&lt;/b&gt; (coisas) são candidatos a &lt;b&gt;classe&lt;/b&gt; — se tiverem comportamento/estado — ou a &lt;b&gt;atributo&lt;/b&gt;, se forem só um valor.&lt;br&gt;• &lt;b&gt;Verbos&lt;/b&gt; (ações) viram &lt;b&gt;operações&lt;/b&gt; (métodos).&lt;br&gt;&lt;br&gt;⚠️ Cuidado: &lt;b&gt;nem todo substantivo vira classe.&lt;/b&gt; &quot;Nome&quot; é substantivo, mas é só um atributo. A pergunta: &lt;i&gt;tem só valor, ou tem valor E comportamento?&lt;/i&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="620" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1" name="2 · v1 — Primeiras classes"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="v1-0"/><mxCell id="v1-1" parent="v1-0"/><mxCell id="v1-1" value="Estágio 2 (v1) — As primeiras classes" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="v1-2" value="Comece pelo essencial: o que o sistema NÃO pode deixar de ter." style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="v1-3" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nome&lt;br/&gt;- email&lt;hr size=&quot;1&quot;/&gt;+ ouvir(musica)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="240" height="92" as="geometry"/></mxCell><mxCell id="v1-4" value="&lt;b&gt;Musica&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- titulo&lt;br/&gt;- duracao&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="120" y="360" width="240" height="92" as="geometry"/></mxCell><mxCell id="v1-5" value="&lt;b&gt;💬 Para explicar em aula:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ainda sem relações, sem herança — só as &lt;b&gt;duas coisas&lt;/b&gt; que dão sentido ao produto: quem ouve (&lt;b&gt;Usuario&lt;/b&gt;) e o que é ouvido (&lt;b&gt;Musica&lt;/b&gt;).&lt;br&gt;&lt;br&gt;🎯 Lição: &lt;b&gt;modelar é recortar.&lt;/b&gt; Não tente prever tudo agora. Um bom modelo começa pequeno e cresce quando a necessidade aparece.&lt;br&gt;&lt;br&gt;Repare: já decidimos que &quot;título&quot; e &quot;duração&quot; são &lt;b&gt;atributos&lt;/b&gt; (só valores), não classes." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="640" height="360" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v2" name="3 · v2 — Atributos e operações"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="v2-0"/><mxCell id="v2-1" parent="v2-0"/><mxCell id="v2-1" value="Estágio 3 (v2) — Damos comportamento às classes" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="v2-2" value="Atributos (o que sabe) + operações (o que faz). Dados privados, acesso por métodos." style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="v2-3" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nome: String&lt;br/&gt;- email: String&lt;hr size=&quot;1&quot;/&gt;+ ouvir(m: Musica): void&lt;br/&gt;+ getNome(): String" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="300" height="108" as="geometry"/></mxCell><mxCell id="v2-4" value="&lt;b&gt;Musica&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- titulo: String&lt;br/&gt;- duracaoSeg: int&lt;br/&gt;- reproducoes: int&lt;hr size=&quot;1&quot;/&gt;+ registrarReproducao(): void&lt;br/&gt;+ duracaoFormatada(): String" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="120" y="360" width="300" height="124" as="geometry"/></mxCell><mxCell id="v2-5" value="&lt;b&gt;💬 Para explicar em aula:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Agora as classes têm &lt;b&gt;estado&lt;/b&gt; (atributos) e &lt;b&gt;comportamento&lt;/b&gt; (operações) — os dois juntos, que é a essência da OO.&lt;br&gt;&lt;br&gt;• &lt;b&gt;-&lt;/b&gt; significa &lt;b&gt;privado&lt;/b&gt;: ninguém mexe no dado direto.&lt;br&gt;• A operação &lt;b&gt;registrarReproducao()&lt;/b&gt; protege o atributo &lt;i&gt;reproducoes&lt;/i&gt;.&lt;br&gt;&lt;br&gt;🎯 Isto prepara o &lt;b&gt;encapsulamento&lt;/b&gt; (o &quot;dia de Java&quot;): o dado é privado e só muda por um método que valida." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="640" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v3" name="4 · v3 — Relacionamento: Playlist"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="v3-0"/><mxCell id="v3-1" parent="v3-0"/><mxCell id="v3-1" value="Estágio 4 (v3) — Surge a necessidade: &quot;montar listas&quot;" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="v3-2" value="O cliente lembrou das playlists. Aparecem RELACIONAMENTOS e MULTIPLICIDADE." style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="v3-3" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nome&lt;br/&gt;- email&lt;hr size=&quot;1&quot;/&gt;+ criarPlaylist(nome)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="100" y="200" width="230" height="92" as="geometry"/></mxCell><mxCell id="v3-4" value="&lt;b&gt;Playlist&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nome&lt;hr size=&quot;1&quot;/&gt;+ adicionar(m)&lt;br/&gt;+ remover(m)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="470" y="200" width="230" height="92" as="geometry"/></mxCell><mxCell id="v3-5" value="&lt;b&gt;Musica&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- titulo&lt;br/&gt;- duracaoSeg&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="840" y="200" width="230" height="92" as="geometry"/></mxCell><mxCell id="v3-6" value="1        monta        0..*" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v3-3" target="v3-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3-7" value="0..*     contém     0..*" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v3-4" target="v3-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3-8" value="&lt;b&gt;💬 Para explicar em aula:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Uma &lt;b&gt;associação&lt;/b&gt; liga objetos que se conhecem. Os números são a &lt;b&gt;multiplicidade&lt;/b&gt;:&lt;br&gt;• um &lt;b&gt;Usuario&lt;/b&gt; monta &lt;b&gt;0..*&lt;/b&gt; playlists;&lt;br&gt;• uma &lt;b&gt;Playlist&lt;/b&gt; contém &lt;b&gt;0..*&lt;/b&gt; músicas, e uma música pode estar em várias.&lt;br&gt;&lt;br&gt;🎯 A multiplicidade documenta uma &lt;b&gt;regra de negócio&lt;/b&gt; (quantos de cada lado) — e mais tarde vira chave estrangeira no banco." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="100" y="430" width="970" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v4" name="5 · v4 — Artista e Álbum"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="v4-0"/><mxCell id="v4-1" parent="v4-0"/><mxCell id="v4-1" value="Estágio 5 (v4) — &quot;Seguir artistas&quot;: entram Artista e Álbum" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="v4-2" value="Aqui aparece a diferença de ouro: COMPOSIÇÃO (Álbum) × AGREGAÇÃO (Playlist)." style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="v4-3" value="&lt;b&gt;Artista&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nomeArtistico&lt;hr size=&quot;1&quot;/&gt;+ publicar(album)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="120" y="180" width="220" height="76" as="geometry"/></mxCell><mxCell id="v4-4" value="&lt;b&gt;Album&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- titulo&lt;br/&gt;- ano&lt;hr size=&quot;1&quot;/&gt;+ adicionarFaixa(...)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="220" height="92" as="geometry"/></mxCell><mxCell id="v4-5" value="&lt;b&gt;Musica&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- titulo&lt;br/&gt;- duracaoSeg&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="220" height="92" as="geometry"/></mxCell><mxCell id="v4-6" value="&lt;b&gt;Playlist&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nome&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="220" height="76" as="geometry"/></mxCell><mxCell id="v4-7" value="1     ◆ faixas     1..*" style="startArrow=diamondThin;startFill=1;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v4-4" target="v4-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v4-8" value="0..*   ◇ contém   0..*" style="startArrow=diamondThin;startFill=0;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v4-6" target="v4-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v4-9" value="*     de     1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v4-5" target="v4-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v4-10" value="&lt;b&gt;💬 Para explicar em aula (o ponto mais importante!):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Álbum ◆ Música (composição):&lt;/b&gt; a faixa &lt;b&gt;nasce dentro&lt;/b&gt; do álbum e não faz sentido sem ele — se o álbum some, a faixa some.&lt;br&gt;• &lt;b&gt;Playlist ◇ Música (agregação):&lt;/b&gt; a playlist só &lt;b&gt;aponta&lt;/b&gt; para músicas que já existem — se a playlist some, as músicas &lt;b&gt;continuam&lt;/b&gt;.&lt;br&gt;&lt;br&gt;A pergunta que decide: &lt;i&gt;&quot;a parte sobrevive sem o todo?&quot;&lt;/i&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="120" y="560" width="1150" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v5" name="6 · v5 — Assinatura e pagamento"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="v5-0"/><mxCell id="v5-1" parent="v5-0"/><mxCell id="v5-1" value="Estágio 6 (v5) — &quot;Pagar assinatura sem anúncios&quot;: streaming encontra o banco" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="v5-2" value="Monetização traz um novo domínio: conta/pagamento. Dois mundos que colaboram." style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="v5-3" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nome&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="220" height="76" as="geometry"/></mxCell><mxCell id="v5-4" value="&lt;b&gt;Assinatura&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- status&lt;br/&gt;- inicio&lt;hr size=&quot;1&quot;/&gt;+ cobrar(conta)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="470" y="200" width="230" height="92" as="geometry"/></mxCell><mxCell id="v5-5" value="&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;Plano&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nome&lt;br/&gt;- precoMensal&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="470" y="420" width="230" height="92" as="geometry"/></mxCell><mxCell id="v5-6" value="&lt;b&gt;ContaBancaria&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- saldo&lt;hr size=&quot;1&quot;/&gt;+ debitar(valor)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="850" y="200" width="240" height="76" as="geometry"/></mxCell><mxCell id="v5-7" value="1     possui     1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v5-3" target="v5-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v5-8" value="1     é de     1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v5-4" target="v5-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v5-9" value="cobra" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v5-4" target="v5-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v5-10" value="1     usa     1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v5-3" target="v5-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v5-11" value="&lt;b&gt;💬 Para explicar em aula:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Uma necessidade de negócio (não ter anúncios) puxa &lt;b&gt;três&lt;/b&gt; classes novas e conecta o app de música a um &lt;b&gt;domínio bancário&lt;/b&gt;.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Assinatura&lt;/b&gt; sabe &lt;i&gt;cobrar&lt;/i&gt;; &lt;b&gt;ContaBancaria&lt;/b&gt; sabe &lt;i&gt;debitar&lt;/i&gt; protegendo o saldo.&lt;br&gt;• &lt;b&gt;Plano&lt;/b&gt; é um &lt;i&gt;enumeration&lt;/i&gt; (Free, Premium, Família).&lt;br&gt;&lt;br&gt;🎯 Modelar revela integrações que a frase original escondia." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="1000" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v6" name="7 · v6 — Herança e polimorfismo"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="v6-0"/><mxCell id="v6-1" parent="v6-0"/><mxCell id="v6-1" value="Estágio 7 (v6) — Tipos de usuário: herança e polimorfismo" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="v6-2" value="Ouvinte e Artista são, ambos, Usuários — com comportamentos diferentes." style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="v6-3" value="&amp;laquo;abstract&amp;raquo;&lt;br/&gt;&lt;b&gt;Usuario&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;# nome&lt;br/&gt;# email&lt;hr size=&quot;1&quot;/&gt;+ tipoDePerfil(): String" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="260" height="92" as="geometry"/></mxCell><mxCell id="v6-4" value="&lt;b&gt;Ouvinte&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;&lt;hr size=&quot;1&quot;/&gt;+ tipoDePerfil()&lt;br/&gt;+ criarPlaylist(...)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="260" height="92" as="geometry"/></mxCell><mxCell id="v6-5" value="&lt;b&gt;Artista&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nomeArtistico&lt;hr size=&quot;1&quot;/&gt;+ tipoDePerfil()&lt;br/&gt;+ receberRoyalty()" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="260" height="92" as="geometry"/></mxCell><mxCell id="v6-6" value="" style="endArrow=block;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v6-4" target="v6-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v6-7" value="" style="endArrow=block;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v6-5" target="v6-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v6-8" value="&lt;b&gt;💬 Para explicar em aula:&lt;/b&gt;&lt;br&gt;&lt;br&gt;A seta de triângulo vazio é &lt;b&gt;generalização (herança)&lt;/b&gt;: &lt;i&gt;Ouvinte É UM Usuario&lt;/i&gt;; &lt;i&gt;Artista É UM Usuario&lt;/i&gt;.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Usuario&lt;/b&gt; é &lt;i&gt;abstract&lt;/i&gt; (itálico): não existe usuário &quot;genérico&quot;.&lt;br&gt;• &lt;b&gt;tipoDePerfil()&lt;/b&gt; é a mesma operação com respostas diferentes = &lt;b&gt;polimorfismo&lt;/b&gt;.&lt;br&gt;&lt;br&gt;🎯 Regra de ouro: só use herança quando o &quot;&lt;b&gt;é um&lt;/b&gt;&quot; for verdadeiro; senão, prefira composição." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="120" y="620" width="1200" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v7" name="8 · v7 — Modelo concreto"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="v7-0"/><mxCell id="v7-1" parent="v7-0"/><mxCell id="v7-1" value="Estágio 8 (v7) — O modelo concreto: tudo junto" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="v7-2" value="De uma frase (página 1) a ISTO. Este diagrama de classes já vira código Java." style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="v7-3" value="&amp;laquo;abstract&amp;raquo;&lt;br/&gt;&lt;b&gt;Usuario&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;# nome&lt;br/&gt;# email&lt;hr size=&quot;1&quot;/&gt;+ tipoDePerfil()" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="240" height="92" as="geometry"/></mxCell><mxCell id="v7-4" value="&lt;b&gt;Ouvinte&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;&lt;hr size=&quot;1&quot;/&gt;+ criarPlaylist(...)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="360" y="250" width="230" height="76" as="geometry"/></mxCell><mxCell id="v7-5" value="&lt;b&gt;Artista&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nomeArtistico&lt;hr size=&quot;1&quot;/&gt;+ receberRoyalty()" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="230" height="76" as="geometry"/></mxCell><mxCell id="v7-6" value="&lt;b&gt;Assinatura&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- status&lt;hr size=&quot;1&quot;/&gt;+ cobrar(conta)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="230" height="76" as="geometry"/></mxCell><mxCell id="v7-7" value="&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;Plano&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- precoMensal&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="120" y="690" width="230" height="76" as="geometry"/></mxCell><mxCell id="v7-8" value="&lt;b&gt;ContaBancaria&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- saldo&lt;hr size=&quot;1&quot;/&gt;+ debitar(v)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="690" width="240" height="76" as="geometry"/></mxCell><mxCell id="v7-9" value="&lt;b&gt;Playlist&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- nome&lt;hr size=&quot;1&quot;/&gt;+ adicionar(m)" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="220" height="76" as="geometry"/></mxCell><mxCell id="v7-10" value="&lt;b&gt;Musica&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- titulo&lt;br/&gt;- duracaoSeg&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="660" y="690" width="220" height="92" as="geometry"/></mxCell><mxCell id="v7-11" value="&lt;b&gt;Album&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;- titulo&lt;br/&gt;- ano&lt;hr size=&quot;1&quot;/&gt;&amp;nbsp;" style="verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="960" y="690" width="220" height="92" as="geometry"/></mxCell><mxCell id="v7-12" value="" style="endArrow=block;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-4" target="v7-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-13" value="" style="endArrow=block;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-5" target="v7-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-14" value="1   possui   1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-4" target="v7-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-15" value="1   é de   1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-6" target="v7-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-16" value="1  usa  1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-4" target="v7-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-17" value="cobra" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-6" target="v7-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-18" value="1   monta   0..*" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-4" target="v7-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-19" value="* ◇ *" style="startArrow=diamondThin;startFill=0;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-9" target="v7-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-20" value="1 ◆ 1..*" style="startArrow=diamondThin;startFill=1;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-11" target="v7-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-21" value="*  de  1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="v7-10" target="v7-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7-22" value="&lt;b&gt;💬 Fecho da aula:&lt;/b&gt;&lt;br&gt;Partimos de UMA frase e chegamos a um modelo com &lt;b&gt;herança&lt;/b&gt;, &lt;b&gt;composição&lt;/b&gt;, &lt;b&gt;agregação&lt;/b&gt;, &lt;b&gt;associação&lt;/b&gt; e &lt;b&gt;multiplicidades&lt;/b&gt;.&lt;br&gt;&lt;br&gt;🎯 &lt;b&gt;Por que modelar importa?&lt;/b&gt; Porque este desenho:&lt;br&gt;• comunica o sistema num relance;&lt;br&gt;• já É a estrutura das classes Java;&lt;br&gt;• expôs regras que a frase escondia." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1240" y="60" width="330" height="460" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="estados" name="9 · Outra lente + fecho"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="estados-0"/><mxCell id="estados-1" parent="estados-0"/><mxCell id="estados-1" value="Bônus — Modelar não é só classes: o ciclo de vida da Assinatura" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="44" as="geometry"/></mxCell><mxCell id="estados-2" value="A mesma Assinatura vista como MÁQUINA DE ESTADOS. Cada diagrama responde a uma pergunta." style="text;html=1;fontSize=15;fontStyle=2;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="28" as="geometry"/></mxCell><mxCell id="estados-3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="26" height="26" as="geometry"/></mxCell><mxCell id="estados-4" value="Ativa" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="240" y="220" width="150" height="44" as="geometry"/></mxCell><mxCell id="estados-5" value="Suspensa" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="480" y="220" width="150" height="44" as="geometry"/></mxCell><mxCell id="estados-6" value="Cancelada" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="220" width="150" height="44" as="geometry"/></mxCell><mxCell id="estados-7" value="" style="ellipse;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="232" width="26" height="26" as="geometry"/></mxCell><mxCell id="estados-8" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="966" y="238" width="14" height="14" as="geometry"/></mxCell><mxCell id="estados-9" value="assinar" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="estados-3" target="estados-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="estados-10" value="cobrança falha [sem saldo]" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="estados-4" target="estados-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="estados-11" value="pagar [saldo ok]" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="estados-5" target="estados-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="estados-12" value="cancelar" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="estados-4" target="estados-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="estados-13" value="cancelar" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="estados-5" target="estados-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="estados-14" value="" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="estados-6" target="estados-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="estados-15" value="&lt;b&gt;💬 Para fechar a aula:&lt;/b&gt;&lt;br&gt;&lt;br&gt;O &lt;b&gt;diagrama de classes&lt;/b&gt; mostra a &lt;i&gt;estrutura&lt;/i&gt;; a &lt;b&gt;máquina de estados&lt;/b&gt; mostra o &lt;i&gt;comportamento no tempo&lt;/i&gt; de um objeto.&lt;br&gt;&lt;br&gt;🎯 &lt;b&gt;Mensagem final:&lt;/b&gt; modelar é ter &lt;b&gt;várias lentes&lt;/b&gt; para o mesmo sistema. Escolha o diagrama que responde à pergunta que você tem agora.&lt;br&gt;&lt;br&gt;➡️ Próximas aulas: cada diagrama da UML em detalhe, sempre sobre este mesmo sistema." style="shape=note;size=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="120" y="360" width="900" height="250" as="geometry"/></mxCell><mxCell id="estados-16" value="Perguntas que cada lente responde:&lt;br&gt;• &lt;b&gt;Classes&lt;/b&gt; → &quot;quais coisas existem e como se ligam?&quot;&lt;br&gt;• &lt;b&gt;Estados&lt;/b&gt; → &quot;por quais fases um objeto passa?&quot;&lt;br&gt;• &lt;b&gt;Casos de uso&lt;/b&gt; → &quot;o que o sistema faz e para quem?&quot;&lt;br&gt;• &lt;b&gt;Sequência&lt;/b&gt; → &quot;em que ordem os objetos conversam?&quot;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fillColor=#F5F5F5;strokeColor=#666666;rounded=1;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="500" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>